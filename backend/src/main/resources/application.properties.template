# QuickServe Backend — Application Properties Template
#
# INSTRUCTIONS:
#   Copy this file to application.properties and fill in your real values.
#   application.properties is git-ignored and must NEVER be committed.
#
# Windows:  copy application.properties.template application.properties
# Linux:    cp  application.properties.template application.properties

spring.application.name=backend

# Server
server.port=8080

# Datasource
spring.datasource.url=jdbc:mysql://localhost:3306/quickserve
spring.datasource.username=<your-database-username>
spring.datasource.password=<your-database-password>

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# JWT Configuration
app.jwt.secret=<your-jwt-secret-minimum-256-bits>
app.jwt.expiration-ms=86400000

# SpringDoc / Swagger UI
springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.swagger-ui.operationsSorter=method
springdoc.swagger-ui.tagsSorter=alpha
springdoc.swagger-ui.try-it-out-enabled=true

# Restaurant Location Configuration (override per deployment via environment variables)
restaurant.location.latitude=${RESTAURANT_LATITUDE:16.5062}
restaurant.location.longitude=${RESTAURANT_LONGITUDE:80.6480}
restaurant.location.radius-meters=${RESTAURANT_RADIUS_METERS:100}

# Owner Account Initial Password (override per deployment via environment variable)
quickserve.owner.password=${QUICKSERVE_OWNER_PASSWORD:<your-owner-password>}

